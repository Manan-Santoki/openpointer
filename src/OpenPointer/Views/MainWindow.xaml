<Window x:Class="OpenPointer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenPointer" Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Background}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Sans}" Foreground="{DynamicResource Foreground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="16,0">
                        <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Primary}" VerticalAlignment="Center">
                            <Path Data="M8,2 C10.2,2 11.5,3.5 11.5,5.6 L11.5,10.4 C11.5,12.5 10.2,14 8,14 C5.8,14 4.5,12.5 4.5,10.4 L4.5,5.6 C4.5,3.5 5.8,2 8,2 Z M8,4.6 L8,6.6"
                                  Stroke="{DynamicResource PrimaryForeground}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="OpenPointer" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Margin="12,8,12,0">
                        <TextBlock Text="DEVICES" Style="{StaticResource Overline}" Margin="4,8,0,8" />
                        <StackPanel x:Name="DeviceList" />

                        <TextBlock Text="CUSTOMIZE" Style="{StaticResource Overline}" Margin="4,20,0,8" />
                        <RadioButton x:Name="NavButtons" Style="{StaticResource NavItem}" Tag="&#xE962;" Content="Buttons" GroupName="Nav" IsChecked="True" Checked="OnNavigate" />
                        <RadioButton x:Name="NavPointer" Style="{StaticResource NavItem}" Tag="&#xEC4A;" Content="Pointer &amp; scrolling" GroupName="Nav" Checked="OnNavigate" />
                        <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="&#xE71D;" Content="Applications" GroupName="Nav" Checked="OnNavigate" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" GroupName="Nav" Checked="OnNavigate" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close to tray" />
                </StackPanel>

                <!-- Options+ conflict banner -->
                <Border x:Name="Banner" Grid.Row="1" Margin="40,0,40,12" Padding="16,12" Style="{StaticResource Card}" Visibility="Collapsed"
                        Background="{DynamicResource Muted}" MaxWidth="760" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Foreground}" />
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="Logi Options+ is running" Style="{StaticResource Label}" />
                            <TextBlock Text="It takes over the same buttons, so your changes may not apply." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Stop Options+" Click="OnStopOptionsPlus" />
                    </Grid>
                </Border>

                <!-- Unsaved changes -->
                <Border x:Name="SaveBar" Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource Background}" Padding="40,12" Visibility="Collapsed">
                    <Grid MaxWidth="760">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Unsaved changes" Style="{StaticResource Label}" />
                            <TextBlock Text="Buttons keep their current behavior until you save." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Discard" Click="OnDiscard" MinWidth="88" />
                        <Button Grid.Column="2" Content="Save" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="88" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentControl x:Name="PageHost" Margin="40,4,40,40" MaxWidth="760" HorizontalAlignment="Stretch" Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Modal layer: dims and blurs the shell; dialogs stack in DialogStack. -->
        <Grid x:Name="OverlayLayer" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource Overlay}" />
            <Grid x:Name="DialogStack" Margin="24,48,24,24" />
            <!-- Keep the caption buttons usable so the window can still be moved to the back or minimized. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
