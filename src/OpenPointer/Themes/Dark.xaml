    <SolidColorBrush x:Key="Foreground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBackground" Color="#0C0C0E" />
    <SolidColorBrush x:Key="Muted" Color="#18181B" />
    <SolidColorBrush x:Key="MutedForeground" Color="#A1A1AA" />
