    <SolidColorBrush x:Key="Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Foreground" Color="#09090B" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Muted" Color="#F4F4F5" />
    <SolidColorBrush x:Key="MutedForeground" Color="#71717A" />
    <SolidColorBrush x:Key="Subtle" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Accent" Color="#F4F4F5" />
    <SolidColorBrush x:Key="AccentStrong" Color="#E4E4E7" />
